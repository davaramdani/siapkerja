# Salin menjadi .env, lalu isi API key milikmu dari https://aistudio.google.com/api-keys
# Tanpa API key, aplikasi berjalan dalam MODE CONTOH (bukan evaluasi AI).
GEMINI_API_KEY=

# Bisa diganti dengan model yang tersedia pada akun Google AI Studio milikmu.
# Materi menggunakan Gemini 2.5 Flash; project baru memakai model yang lebih baru.
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
